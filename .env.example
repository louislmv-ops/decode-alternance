# Copier en .env.local pour le développement. Aucune variable n'est obligatoire :
# sans elles, le site tourne avec les offres d'exemple et sans traduction par l'IA.

# Traduction des offres (console.anthropic.com). Mettre une limite de dépense sur la clé.
ANTHROPIC_API_KEY=
# Modèle utilisé pour traduire (par défaut claude-opus-5-5).
DECODE_MODEL=
# Nombre de traductions par heure et par adresse IP (par défaut 10).
DECODE_PER_HOUR=

# Base Postgres des offres (Supabase, Neon, Vercel Postgres…). Lancer db/schema.sql une fois.
DATABASE_URL=

# API Offres d'emploi de France Travail (francetravail.io, application abonnée à l'API).
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Secret envoyé par le cron Vercel à /api/cron/ingest.
CRON_SECRET=

# Adresse de contact affichée dans le user-agent du robot de collecte (ASCII uniquement).
BOT_CONTACT=

# Adresse e-mail affichée pour la formule Écoles. Sans elle, le bouton indique « Contact bientôt ».
NEXT_PUBLIC_CONTACT_EMAIL=

# Mentions légales (obligatoires dès que le site est public)
LEGAL_EDITOR=
LEGAL_ADDRESS=
LEGAL_SIREN=
LEGAL_CONTACT=
# Adresse publique du site (sitemap, partage)
NEXT_PUBLIC_SITE_URL=
# Plafonds du décodeur par adresse IP
DECODE_PER_HOUR=10
DECODE_PER_DAY=30

# Comptes et alertes : base, e-mails (Resend), SMS (Brevo, optionnel)
AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
BREVO_API_KEY=
SMS_SENDER=Decode

# Modération de la commu : adresses des modérateurs, séparées par des virgules
ADMIN_EMAILS=
